# Frontend Environment Configuration for OmniStore AI

# When running locally, point to your local FastAPI server:
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# On Vercel, API routes are proxied via vercel.json rewrites:
NEXT_PUBLIC_API_URL=/api/v1

# Set to your production Vercel deployment URL (e.g., https://your-project.vercel.app):
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_ASSISTANT_NAME="OmniStore AI Assistant"
